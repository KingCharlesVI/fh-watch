# Copy to api/.env for development. Production reads /etc/fh/api.env via systemd.
DATABASE_URL=postgres://fh:CHANGE_ME@localhost:5432/fh_dev
TEST_DATABASE_URL=postgres://fh:CHANGE_ME@localhost:5432/fh_test

# At least 32 characters. Unset in development: a random key per process.
JWT_SECRET=

WEB_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3001

# Unset: emails and pushes are written to the log instead of being sent.
# Production uses Amazon SES (see docs/deployment.md, Email), with the password URL-encoded:
# SMTP_URL=smtps://SMTP-USER-NAME:ENCODED-PASSWORD@email-smtp.eu-west-2.amazonaws.com:465
SMTP_URL=
MAIL_FROM=FH Match Centre <no-reply@fhmatchcentre.com>
EXPO_ACCESS_TOKEN=

JOBS_ENABLED=true
