{
  "name": "fh-watch",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:web": "node scripts/dev.mjs api web",
    "dev:mobile": "node scripts/dev.mjs api mobile",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "gen:schema": "pnpm --filter @fh/shared gen:schema",
    "dev:watch": "node scripts/dev.mjs watch",
    "release:android": "node scripts/release-android.mjs",
    "release:phone": "node scripts/release-android.mjs phone",
    "release:watch": "node scripts/release-android.mjs watch",
    "release:github": "node scripts/github-release.mjs",
    "release:play": "node scripts/play-upload.mjs",
    "release:ios": "cd mobile && npx --yes eas-cli build --platform ios --profile alpha --auto-submit"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  },
  "devDependencies": {
    "@googleapis/androidpublisher": "^42.1.0"
  }
}
