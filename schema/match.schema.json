{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "UUIDv7 created on the watch. Stable from watch to website."
    },
    "createdOn": {
      "type": "string",
      "enum": [
        "wear",
        "watchos",
        "mobile",
        "web"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "periodLengthSec": {
          "type": "integer",
          "minimum": 60,
          "maximum": 5400
        },
        "breakLengthsSec": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          },
          "description": "Break after each period except the last, so periods - 1 entries."
        },
        "cardDurationsSec": {
          "type": "object",
          "properties": {
            "green": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "yellowShort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "yellowLong": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "green",
            "yellowShort",
            "yellowLong"
          ],
          "additionalProperties": false
        },
        "shootoutIfDrawn": {
          "type": "boolean"
        }
      },
      "required": [
        "periods",
        "periodLengthSec",
        "breakLengthsSec",
        "cardDurationsSec",
        "shootoutIfDrawn"
      ],
      "additionalProperties": false
    },
