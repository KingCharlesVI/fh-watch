[Unit]
Description=FH Match Centre website
After=network-online.target fh-api.service
Wants=network-online.target

[Service]
Type=simple
User=fh-web
Group=fh-web
WorkingDirectory=/opt/fh/current/web
EnvironmentFile=/etc/fh/web.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3000 --hostname 127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Next writes to .next/cache in the release; deploy.sh gives fh-web that folder only.
ReadWritePaths=/opt/fh/releases
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
