[Unit]
Description=FH Match Centre API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=fh-api
Group=fh-api
WorkingDirectory=/opt/fh/current/api
EnvironmentFile=/etc/fh/api.env
Environment=NODE_ENV=production
# Chromium (PDF reports) wants a writable home.
Environment=HOME=/var/cache/fh-api
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
TimeoutStopSec=20

# /var/cache/fh-api: PDF cache and Chromium's profile.
CacheDirectory=fh-api
CacheDirectoryMode=0750

# Hardening. Not MemoryDenyWriteExecute: V8 and Chromium need JIT memory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
