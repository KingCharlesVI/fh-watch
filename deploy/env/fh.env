# fh.env: settings for the fh command (deploys and backups). The provision script fills in the __PLACEHOLDERS__.

# Where releases are cloned from. This machine must be able to read it: a deploy key on Linux,
# your own Git sign-in on Windows. A folder path to a clone works too.
REPO_URL=__REPO_URL__
# Releases kept for rollback.
KEEP_RELEASES=5

# Database backups kept on this machine, in days.
KEEP_DAYS=14
# Off-site copy with rclone, e.g. "b2:fh-backups". Empty: backups stay on this machine only.
RCLONE_REMOTE=
RCLONE_CONFIG=__RCLONE_CONFIG__
# The rclone program, if it isn't on the system PATH.
RCLONE=

# Windows: where the PostgreSQL tools and cloudflared are. Empty on Linux, where they're on the PATH.
PG_BIN=__PG_BIN__
CLOUDFLARED=__CLOUDFLARED__
