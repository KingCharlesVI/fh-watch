# web-beta.env: the beta website's settings, also read when a beta release is built.
# The beta site is deployed from a branch with `fh deploy --beta <branch>` and uses the live API and database.
# After editing, deploy again (the build uses SITE_URL), or for HOST/PORT just restart fh-web-beta.
# After changing SITE_URL, run `fh tunnel` so the new address reaches this machine.

NODE_ENV=production
HOST=127.0.0.1
PORT=3002
API_URL=http://127.0.0.1:3001
SITE_URL=https://beta.fhmatchcentre.com
NEXT_TELEMETRY_DISABLED=1
# Asks search engines not to list the beta site.
NOINDEX=true
