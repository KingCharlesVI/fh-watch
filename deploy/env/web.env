# web.env: the website's settings, also read when a release is built.
# After editing, deploy again (the build uses SITE_URL), or for HOST/PORT just restart fh-web.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
API_URL=http://127.0.0.1:3001
SITE_URL=https://app.fhmatchcentre.com
NEXT_TELEMETRY_DISABLED=1
