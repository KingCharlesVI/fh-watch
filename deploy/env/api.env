# api.env: the API's settings. The provision script fills in the __PLACEHOLDERS__.
# After editing, restart the API: `sudo systemctl restart fh-api` (Linux) or `Restart-Service fh-api` (Windows).

NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgres://fh:__DB_PASSWORD__@127.0.0.1:__DB_PORT__/fh
JWT_SECRET=__JWT_SECRET__

WEB_URL=https://fhmatchcentre.com
MAIL_FROM=FH Match Centre <no-reply@fhmatchcentre.com>

# Cloudflare puts each visitor's IP address in this header. The sign-in rate limits use it.
CLIENT_IP_HEADER=cf-connecting-ip

# Your email provider's SMTP details, e.g. smtps://USERNAME:PASSWORD@smtp.example.com:465
# (URL-encode any special characters in the password). Empty: emails only go to the log.
SMTP_URL=

# From expo.dev → Access tokens, once the phone app sends push notifications. Optional.
EXPO_ACCESS_TOKEN=

PDF_CACHE_DIR=__PDF_CACHE_DIR__
PLAYWRIGHT_BROWSERS_PATH=__PLAYWRIGHT_DIR__
JOBS_ENABLED=true
