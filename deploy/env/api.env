# /etc/fh/api.env: read by fh-api.service. provision.sh fills in the __PLACEHOLDERS__.
# After editing: systemctl restart fh-api

NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgres://fh:__DB_PASSWORD__@127.0.0.1:5432/fh
JWT_SECRET=__JWT_SECRET__

WEB_URL=https://fhmatchcentre.com
MAIL_FROM=FH Match Centre <no-reply@fhmatchcentre.com>

# Your email provider's SMTP details, e.g. smtps://USERNAME:PASSWORD@smtp.example.com:465
# (URL-encode any special characters in the password). Empty: emails only go to the log.
SMTP_URL=

# From expo.dev → Access tokens, once the phone app sends push notifications. Optional.
EXPO_ACCESS_TOKEN=

PDF_CACHE_DIR=/var/cache/fh-api/pdf
PLAYWRIGHT_BROWSERS_PATH=/opt/fh/ms-playwright
JOBS_ENABLED=true
