# api.env: the API's settings. The provision script fills in the __PLACEHOLDERS__.
# After editing, restart the API: `sudo systemctl restart fh-api` (Linux) or `Restart-Service fh-api` (Windows).

NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgres://fh:__DB_PASSWORD__@127.0.0.1:__DB_PORT__/fh
JWT_SECRET=__JWT_SECRET__

WEB_URL=https://app.fhmatchcentre.com
# The landing page. Its "join the testing" forms post to this API, and only its origin may.
LANDING_URL=https://fhmatchcentre.com

# Where an approved tester accepts their invitation, sent to them in the approval email.
# Play Console -> Internal testing -> Testers -> "Join on Android", and TestFlight's public link.
# Empty: the email says the invitation follows.
PLAY_TEST_URL=
TESTFLIGHT_URL=
MAIL_FROM=FH Match Centre <no-reply@fhmatchcentre.com>

# Cloudflare puts each visitor's IP address in this header. The sign-in rate limits use it.
CLIENT_IP_HEADER=cf-connecting-ip

# Amazon SES SMTP credentials (docs/deployment.md, Email), with the password URL-encoded:
# smtps://SMTP-USER-NAME:ENCODED-PASSWORD@email-smtp.eu-north-1.amazonaws.com:465
# Empty: emails only go to the log.
SMTP_URL=

# From expo.dev → Access tokens, once the phone app sends push notifications. Optional.
EXPO_ACCESS_TOKEN=

PDF_CACHE_DIR=__PDF_CACHE_DIR__
PLAYWRIGHT_BROWSERS_PATH=__PLAYWRIGHT_DIR__
JOBS_ENABLED=true
