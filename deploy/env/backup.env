# /etc/fh/backup.env: read by fh-backup.service.

# Local copies kept for this many days.
KEEP_DAYS=14

# Off-site copy with rclone, e.g. "b2:fh-backups" or "r2:fh-backups/db".
# Set up the remote first: rclone config --config /etc/fh/rclone.conf
# Empty: backups stay on this server only.
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/fh/rclone.conf
